# Modelo seguro para `backend/.env` em desenvolvimento.
# Copie, preencha os campos vazios e nunca versione o arquivo resultante.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL 15+. A senha pode ser fornecida por PGPASSWORD ou pelo seu gerenciador
# de segredos; não a grave neste arquivo de exemplo.
DATABASE_URL=postgresql+psycopg2://sua_plataforma_app@127.0.0.1:5432/sua_plataforma
PGPASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Gere cada valor separadamente com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
CLIENT_TOKEN=
PUBLIC_API_KEY=
PUBLIC_API_SECRET=
MONITORING_TOKEN=
ADMIN_EMAILS=admin@exemplo.com
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
ALLOWED_HOSTS=localhost,127.0.0.1
TRUST_PROXY_HEADERS=false

# URLs públicas e transporte interno.
APP_NAME=SUA_EMPRESA
PUBLIC_BASE_URL=http://127.0.0.1:8002
PUBLIC_APP_URL=http://localhost:3004
BACKEND_URL=http://127.0.0.1:8002
REDIS_URL=redis://127.0.0.1:6379/0
WEBSOCKET_REDIS_URL=redis://127.0.0.1:6379/0
WEBSOCKET_CHANNEL_NAMESPACE=sua-plataforma:development
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Diretórios locais ignorados pelo Git.
APP_DATA_DIR=./var
MEDIA_BASE_PATH=./var/media
WAHA_MEDIA_DIR=./var/media/waha
CHAT_MEMORY_DIR=./var/chatmemory
LOG_DIR=./var/logs
COMPANY_LOGO_DIR=./var/logos
COMPANY_LOGO_PUBLIC_PREFIX=/media/logos
ACCOUNT_PROFILE_PHOTO_DIR=./var/account-profiles
ACCOUNT_PROFILE_PHOTO_PUBLIC_PREFIX=/media/account-profiles

# WhatsApp/WAHA. Deixe desabilitado enquanto não configurar o serviço.
WAHA_ENABLED=false
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=
WAHA_DEFAULT_ENGINE=GOWS

# IA. OPENAI_API_KEY é apenas para módulos legados que ainda precisem de uma
# chave global. Prefira credenciais BYOK cadastradas pela interface.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLE_TRACING=false
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_PROVIDER_TOKEN_ENCRYPTION_KEY=

# E-mail transacional via SMTP genérico. O envio é habilitado quando
# SMTP_HOST e SMTP_FROM_EMAIL estão preenchidos. Usuário e senha são opcionais,
# mas, quando usados, devem ser configurados juntos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SUA_EMPRESA
SMTP_STARTTLS=true
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Google Calendar opcional.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3004/api/integrations/calendar/google/oauth/callback
GOOGLE_OAUTH_FRONTEND_REDIRECT_ORIGIN=http://localhost:3004

# API pública: limites conservadores para desenvolvimento.
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=10
