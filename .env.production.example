# Modelo seguro para o EnvironmentFile do backend em produção.
# Todos os campos vazios devem ser injetados por um gerenciador de segredos ou
# preenchidos em um arquivo fora do repositório, com permissão 600.

ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql+psycopg2://sua_plataforma_app@127.0.0.1:5432/sua_plataforma
PGPASSWORD=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

JWT_SECRET_KEY=
CLIENT_TOKEN=
PUBLIC_API_KEY=
PUBLIC_API_SECRET=
MONITORING_TOKEN=
ADMIN_EMAILS=admin@exemplo.com
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
ALLOWED_HOSTS=app.seudominio.com.br
TRUST_PROXY_HEADERS=true
CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

APP_NAME=SUA_EMPRESA
PUBLIC_BASE_URL=https://app.seudominio.com.br
PUBLIC_APP_URL=https://app.seudominio.com.br
BACKEND_URL=http://127.0.0.1:8002
REDIS_URL=redis://127.0.0.1:6379/0
WEBSOCKET_REDIS_URL=redis://127.0.0.1:6379/0
WEBSOCKET_CHANNEL_NAMESPACE=sua-plataforma:production
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

APP_DATA_DIR=/srv/sua-plataforma/shared
MEDIA_BASE_PATH=/srv/sua-plataforma/shared/media
WAHA_MEDIA_DIR=/srv/sua-plataforma/shared/media/waha
CHAT_MEMORY_DIR=/srv/sua-plataforma/shared/chatmemory
LOG_DIR=/srv/sua-plataforma/shared/logs
COMPANY_LOGO_DIR=/srv/sua-plataforma/shared/logos
COMPANY_LOGO_PUBLIC_PREFIX=/media/logos
ACCOUNT_PROFILE_PHOTO_DIR=/srv/sua-plataforma/shared/account-profiles
ACCOUNT_PROFILE_PHOTO_PUBLIC_PREFIX=/media/account-profiles

WAHA_ENABLED=false
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=
WAHA_DEFAULT_ENGINE=GOWS

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLE_TRACING=false
AI_PROVIDER_TOKEN_ENCRYPTION_KEY=

# SMTP transacional. Habilite com HOST+FROM; configure usuário e senha juntos
# quando o servidor exigir autenticação.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SUA_EMPRESA
SMTP_STARTTLS=true
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.seudominio.com.br/api/integrations/calendar/google/oauth/callback
GOOGLE_OAUTH_FRONTEND_REDIRECT_ORIGIN=https://app.seudominio.com.br

RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=30
