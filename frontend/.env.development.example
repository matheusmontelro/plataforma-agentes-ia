# Frontend development template. Do not put secrets here.

# Por segurança, o Vite aceita conexões apenas da própria máquina. Use um túnel
# SSH se desenvolver em um servidor remoto, em vez de expor esta porta na internet.
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=3004

# Backend target used by the Vite proxy. Browser requests still use the frontend origin.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8002

# Public app origin is only for external links/webhooks shown to users.
VITE_PUBLIC_APP_ORIGIN=http://localhost:3004

# Branding da sua instalacao. Troque tambem os arquivos em public/branding/.
VITE_APP_NAME=SUA_EMPRESA
VITE_APP_DESCRIPTION=Plataforma de atendimento, CRM e automacoes com IA
VITE_SUPPORT_NAME=Equipe de suporte
VITE_SUPPORT_EMAIL=suporte@seu-dominio.com

# Keep false by default. Set true only when intentionally testing a cross-origin API base.
VITE_FORCE_ABSOLUTE_API=false
