# Variáveis das rotas de API pública.
# Copie somente as chaves necessárias para `backend/.env` ou para o
# EnvironmentFile do serviço. Nunca use os valores de outro ambiente.

# Gere valores distintos com:
# python -c "import secrets; print(secrets.token_hex(32))"
PUBLIC_API_KEY=
PUBLIC_API_SECRET=

RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=10
